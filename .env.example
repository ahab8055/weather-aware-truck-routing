# Each app loads its own .env file. Copy the per-app examples:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#
# backend/.env (server-side only; never expose these to the frontend)
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORS_API_KEY=your-openrouteservice-api-key
# Optional: override the ORS endpoint (e.g. a self-hosted instance)
ORS_BASE_URL=https://api.openrouteservice.org
# Geocoding region: empty (default) searches worldwide; an ISO country code such as
# US or PK limits origin/destination search to that country.
ORS_GEOCODE_COUNTRY=
# Optional: Open-Meteo forecast API base URL (no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Production HTTPS hardening (leave off for local HTTP):
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_PROXY_SSL_HEADER=true   # only behind a proxy that sets X-Forwarded-Proto
#
# frontend/.env (public: VITE_* values are bundled into client code)
VITE_API_BASE_URL=http://localhost:8000/api
